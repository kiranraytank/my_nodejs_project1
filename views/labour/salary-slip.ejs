<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salary Slip</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @media print {
            .no-print {
                display: none;
            }
            .container {
                width: 100%;
                max-width: 100%;
            }
        }
        .salary-slip {
            border: 2px solid #000;
            padding: 20px;
            margin: 20px 0;
        }
        .company-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .slip-details {
            margin: 20px 0;
        }
        .amount-details {
            margin-top: 30px;
        }
        .signature-section {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="no-print mb-3">
            <button onclick="window.print()" class="btn btn-primary">Print Slip</button>
            <a href="/labour/management" class="btn btn-secondary">Back to Management</a>
        </div>

        <div class="salary-slip">
            <div class="company-header">
                <h2>Company Name</h2>
                <h4>Salary Slip</h4>
            </div>

            <div class="row slip-details">
                <div class="col-md-6">
                    <p><strong>Employee Name:</strong> <%= slip.username %></p>
                    <p><strong>Task:</strong> <%= slip.task_name %></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Period:</strong> <%= new Date(slip.start_date).toLocaleDateString() %> to <%= new Date(slip.end_date).toLocaleDateString() %></p>
                    <p><strong>Slip Date:</strong> <%= new Date(slip.generated_date).toLocaleDateString() %></p>
                </div>
            </div>

            <div class="amount-details">
                <table class="table table-bordered">
                    <tr>
                        <th>Days Worked</th>
                        <td><%= slip.days_worked %></td>
                    </tr>
                    <tr>
                        <th>Daily Wage</th>
                        <td>₹<%= slip.daily_wage %></td>
                    </tr>
                    <tr>
                        <th>Total Amount</th>
                        <td>₹<%= slip.total_amount.toFixed(2) %></td>
                    </tr>
                </table>
            </div>

            <div class="signature-section">
                <div>
                    <p>Employee Signature</p>
                    <div style="border-top: 1px solid #000; width: 200px;"></div>
                </div>
                <div>
                    <p>Authorized Signature</p>
                    <div style="border-top: 1px solid #000; width: 200px;"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 