<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin List - Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="/css/admin-list.css">
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-header">
                <h2>Admin Panel</h2>
            </div>
            <nav>
                <a href="/admin/dashboard" class="nav-item">
                    <i class="fas fa-tachometer-alt"></i>
                    Dashboard
                </a>
                <a href="/admin/list" class="nav-item active">
                    <i class="fas fa-users-cog"></i>
                    Admins
                </a>
                <a href="/admin/users" class="nav-item">
                    <i class="fas fa-users"></i>
                    Users
                </a>
                <a href="/admin/settings" class="nav-item">
                    <i class="fas fa-cog"></i>
                    Settings
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="content">
            <div class="admin-list-content">
                <div class="admin-list-header">
                    <h1>Admin List</h1>
                    <a href="/admin/create" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                        Add New Admin
                    </a>
                </div>

                <% if (messages.success) { %>
                    <div class="alert alert-success">
                        <%= messages.success %>
                    </div>
                <% } %>

                <% if (messages.error) { %>
                    <div class="alert alert-error">
                        <%= messages.error %>
                    </div>
                <% } %>

                <% if (admins && admins.length > 0) { %>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% admins.forEach(admin => { %>
                                <tr>
                                    <td><%= admin.name %></td>
                                    <td><%= admin.email %></td>
                                    <td>
                                        <span class="status-badge <%= admin.status ? 'active' : 'inactive' %>">
                                            <%= admin.status ? 'Active' : 'Inactive' %>
                                        </span>
                                    </td>
                                    <td class="actions">
                                        <a href="/admin/edit/<%= admin._id %>" class="btn btn-info btn-sm">
                                            <i class="fas fa-edit"></i>
                                            Edit
                                        </a>
                                        <form action="/admin/delete/<%= admin._id %>" method="POST" style="display: inline;">
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this admin?')">
                                                <i class="fas fa-trash"></i>
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="empty-state">
                        <p>No admin users found.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html> 