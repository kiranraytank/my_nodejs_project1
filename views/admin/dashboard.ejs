          <!-- Include Sidebar -->
          <%- include('./partials/sidebar') %>
        
          <div class="main-content">
              <!-- Include Topbar -->
              <%- include('./partials/topbar') %>
            
            <div class="content">
                <div class="page-content">
                    <div class="page-header">
                        <h1>Dashboard Overview</h1>
                    </div>
                    
                    <div class="stats-grid">
                        <div class="stat-card">
                            <h3>Total Admins</h3>
                            <p><%= adminStats.total %></p>
                        </div>
                        <div class="stat-card">
                            <h3>Active Admins</h3>
                            <p><%= adminStats.active %></p>
                        </div>
                        <div class="stat-card">
                            <h3>Inactive Admins</h3>
                            <p><%= adminStats.inactive %></p>
                        </div>
                    </div>

                    <% if (typeof messages !== 'undefined' && messages) { %>
                        <% if (messages.success) { %>
                            <div class="alert alert-success">
                                <%= messages.success %>
                            </div>
                        <% } %>

                        <% if (messages.error) { %>
                            <div class="alert alert-error">
                                <%= messages.error %>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <div class="recent-activity">
                    <h2>Recent Activity</h2>
                    <div class="admin-table-container">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Admin</th>
                                    <th>Action</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof recentActivity !== 'undefined' && recentActivity.length > 0) { %>
                                    <% recentActivity.forEach(activity => { %>
                                    <tr>
                                        <td><%= activity.admin %></td>
                                        <td><%= activity.action %></td>
                                        <td><%= activity.date %></td>
                                    </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="text-center">No recent activity</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</body>

<!-- Include Footer -->
<%- include('./partials/footer') %>

</html>